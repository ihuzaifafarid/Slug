# GEMINI_API_KEY: Required for Gemini AI API calls (SEO suggestions and assistant).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# JWT_SECRET: Cryptographic secret used for signing and verifying user session tokens.
JWT_SECRET="slugify_jwt_super_secret_key_2026_x7a9"

# ADMIN_EMAIL: Email address designated as the platform owner and super administrator.
ADMIN_EMAIL="huzaifaahmedary@gmail.com"

# ADMIN_INITIAL_PASSWORD: Password seeded for initial administrator login.
ADMIN_INITIAL_PASSWORD="Admin@Slugify2026"

# LEMON_SQUEEZY_API_KEY: Lemon Squeezy API Key (from Dashboard -> Settings -> API Keys).
LEMON_SQUEEZY_API_KEY=""

# LEMON_SQUEEZY_STORE_ID: Your numeric Lemon Squeezy Store ID (from Dashboard -> Settings -> Stores).
LEMON_SQUEEZY_STORE_ID=""

# LEMON_SQUEEZY_WEBHOOK_SECRET: Secret signing key for verifying incoming HMAC SHA-256 webhooks (from Dashboard -> Settings -> Webhooks).
LEMON_SQUEEZY_WEBHOOK_SECRET=""

# LEMON_SQUEEZY_PRO_VARIANT_ID: Numeric variant ID for the Pro subscription tier ($5/month) created in your Lemon Squeezy store.
LEMON_SQUEEZY_PRO_VARIANT_ID=""

# LEMON_SQUEEZY_PREMIUM_VARIANT_ID: Numeric variant ID for the Premium subscription tier ($12/month) created in your Lemon Squeezy store.
LEMON_SQUEEZY_PREMIUM_VARIANT_ID=""
